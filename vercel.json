{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/callback.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/callback", "destination": "/api/callback" },
    { "source": "/api/chat", "destination": "/api/chat" }
  ]
}
